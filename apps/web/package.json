{
  "name": "@mira-cloud/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm tokens:check && vite --host 127.0.0.1",
    "build": "pnpm tokens:check && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tokens:generate": "tsx scripts/generate-tokens.ts",
    "tokens:check": "tsx scripts/generate-tokens.ts --check",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.ts\" \"tests/**/*.{ts,tsx}\" \"*.{ts,json,html}\"",
    "lint": "eslint src scripts tests",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "NODE_USE_ENV_PROXY=0 vitest run",
    "check": "pnpm tokens:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm build"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "2.1.18",
    "@tailwindcss/vite": "4.3.5",
    "lucide-react": "1.71.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "react-tooltip": "6.0.7",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@ant-design/colors": "8.0.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
