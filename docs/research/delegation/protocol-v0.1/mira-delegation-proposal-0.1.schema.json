{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mira:delegation:proposal:0.1.0",
  "title": "Mira Delegation Proposal — model output research contract v0.1.0",
  "description": "A non-authoritative proposal. It cannot grant permissions, accept stages, create tasks, or report execution.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocol": {
      "const": "mira.delegation.proposal"
    },
    "version": {
      "const": "0.1.0"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 650
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 360
          },
          "paragraphs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 700
            }
          },
          "fields": {
            "type": "array",
            "maxItems": 12,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[a-z][a-z0-9-]*$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "choice",
                    "boolean",
                    "text"
                  ]
                },
                "options": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "key": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64,
                        "pattern": "^[a-z0-9][a-z0-9-]*$"
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      }
                    },
                    "required": [
                      "key",
                      "label"
                    ]
                  },
                  "maxItems": 8
                },
                "suggestedValue": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 400
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "rationale": {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 320
                }
              },
              "required": [
                "key",
                "label",
                "kind",
                "options",
                "suggestedValue",
                "rationale"
              ]
            }
          }
        },
        "required": [
          "key",
          "title",
          "purpose",
          "paragraphs",
          "fields"
        ]
      }
    },
    "unknowns": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 320
          },
          "impact": {
            "type": "string",
            "minLength": 1,
            "maxLength": 320
          }
        },
        "required": [
          "key",
          "question",
          "impact"
        ]
      }
    },
    "assumptions": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 320
          },
          "impact": {
            "type": "string",
            "minLength": 1,
            "maxLength": 320
          }
        },
        "required": [
          "key",
          "statement",
          "impact"
        ]
      }
    },
    "claims": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 380
          },
          "sourceRefs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96,
              "pattern": "^[a-zA-Z0-9._:/-]+$"
            }
          }
        },
        "required": [
          "key",
          "statement",
          "sourceRefs"
        ]
      }
    }
  },
  "required": [
    "protocol",
    "version",
    "title",
    "summary",
    "stages",
    "unknowns",
    "assumptions",
    "claims"
  ]
}
